# -*- mode: ruby -*-
# vi: set ft=ruby :

# Définition des machines virtuelles à déployer
VMS = [
  { name: "monitoring", ip: "192.168.56.10", cpus: 2, memory: 2048 },
  { name: "k8s-master", ip: "192.168.56.11", cpus: 2, memory: 4096 }, # K8s master : 2 à 4 Go conseillés
  { name: "k8s-worker", ip: "192.168.56.12", cpus: 2, memory: 4096 },
  { name: "jenkins",    ip: "192.168.56.13", cpus: 2, memory: 2048 }
]

# Détection automatique de la clé publique de l'hôte Ubuntu 24.04
# (Ansible utilise la clé privée correspondante, qui reste sur l'hôte)
pub_key_path = File.expand_path("~/.ssh/id_ed25519.pub")
pub_key_path = File.expand_path("~/.ssh/id_rsa.pub") unless File.exist?(pub_key_path)

if File.exist?(pub_key_path)
  SSH_PUB_KEY = File.read(pub_key_path).strip
else
  puts "⚠️ ATTENTION : Aucune clé publique trouvée dans ~/.ssh/ (id_ed25519.pub ou id_rsa.pub)."
  puts "   Générez-en une avec : ssh-keygen -t ed25519   puis relancez : vagrant provision"
  SSH_PUB_KEY = ""
end

Vagrant.configure("2") do |config|
  # Image Ubuntu 24.04 LTS (Noble Numbat)
  config.vm.box = "bento/ubuntu-24.04"

  # Laisse plus de temps au démarrage : 4 VM lancées à la suite peuvent dépasser
  # le délai par défaut (300 s). Un timeout interrompt Vagrant AVANT la configuration
  # du hostname et du réseau privé -> VM "vagrant" avec eth1 DOWN.
  config.vm.boot_timeout = 600

  # Désactive la mise à jour automatique des Guest Additions pour accélérer le démarrage
  config.vbguest.auto_update = false if defined?(VagrantVbguest)

  VMS.each do |machine|
    config.vm.define machine[:name] do |node|
      node.vm.hostname = machine[:name]

      # Réseau privé (Host-Only) : IP fixe joignable par Ansible depuis l'hôte
      node.vm.network "private_network", ip: machine[:ip]

      node.vm.provider "virtualbox" do |vb|
        vb.name   = machine[:name]
        vb.memory = machine[:memory]
        vb.cpus   = machine[:cpus]
        vb.gui    = false
        # S'assure que le "câble" de la carte host-only est bien branché
        vb.customize ["modifyvm", :id, "--cableconnected2", "on"]
      end

      # Provisioning initial : réseau, SSH, heure, Python (requis par Ansible)
      node.vm.provision "shell", inline: <<-SHELL
        set -u

        # 0. Filet de sécurité réseau : garantit que eth1 porte l'IP fixe
        if [ ! -f /etc/netplan/50-vagrant.yaml ]; then
          cat > /etc/netplan/50-vagrant.yaml <<EOF
network:
  version: 2
  ethernets:
    eth1:
      addresses: [#{machine[:ip]}/24]
EOF
        fi
        chmod 600 /etc/netplan/*.yaml
        netplan apply || true

        # 1. Injection de la clé publique de l'hôte (sans doublon si on reprovisionne)
        if [ -n "#{SSH_PUB_KEY}" ]; then
          install -d -m 700 -o vagrant -g vagrant /home/vagrant/.ssh
          touch /home/vagrant/.ssh/authorized_keys
          grep -qxF "#{SSH_PUB_KEY}" /home/vagrant/.ssh/authorized_keys || \
            echo "#{SSH_PUB_KEY}" >> /home/vagrant/.ssh/authorized_keys
          chmod 600 /home/vagrant/.ssh/authorized_keys
          chown vagrant:vagrant /home/vagrant/.ssh/authorized_keys
        fi

        # 2. Synchronisation de l'horloge (évite les erreurs APT "not valid yet")
        timedatectl set-ntp true || true
        systemctl restart systemd-timesyncd 2>/dev/null || true
        sleep 3

        # 3. Installation de python3 (indispensable pour les modules Ansible)
        export DEBIAN_FRONTEND=noninteractive
        apt-get update -qq
        apt-get install -y -qq python3 python3-apt curl
      SHELL

      # -----------------------------------------------------------------------
      # OPTIONNEL : décommentez UNIQUEMENT si vous voulez copier votre CLÉ PRIVÉE
      # dans les VMs (ex : rebond SSH). Déconseillé : c'est votre clé personnelle.
      # -----------------------------------------------------------------------
      # priv_key = pub_key_path.sub('.pub', '')
      # node.vm.provision "file", source: priv_key, destination: "/home/vagrant/.ssh/id_ed25519" if File.exist?(priv_key)
      # node.vm.provision "shell", inline: "chmod 600 /home/vagrant/.ssh/id_ed25519 && chown vagrant:vagrant /home/vagrant/.ssh/id_ed25519"
    end
  end
end
